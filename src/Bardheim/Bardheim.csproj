<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Bardheim</AssemblyName>
    <RootNamespace>Bardheim</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.7.0</Version>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == '' and '$(VALHEIM_INSTALL)' != ''">$(VALHEIM_INSTALL)\valheim_Data\Managed</ValheimManagedDir>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManagedDir>
    <BepInExProfileDir Condition="'$(BepInExProfileDir)' == '' and '$(BEPINEX_PROFILE_DIR)' != ''">$(BEPINEX_PROFILE_DIR)</BepInExProfileDir>
    <BepInExProfileDir Condition="'$(BepInExProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\valheimbot</BepInExProfileDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == '' and '$(BEPINEX_CORE_DIR)' != ''">$(BEPINEX_CORE_DIR)</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(BepInExProfileDir)\BepInEx\core</BepInExCoreDir>
    <JotunnDir Condition="'$(JotunnDir)' == '' and '$(JOTUNN_DIR)' != ''">$(JOTUNN_DIR)</JotunnDir>
    <JotunnDir Condition="'$(JotunnDir)' == ''">$(BepInExProfileDir)\BepInEx\plugins\ValheimModding-Jotunn</JotunnDir>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(USERPROFILE)\.nuget\packages\</NuGetPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" Condition="Exists('$(BepInExCoreDir)\BepInEx.dll')">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard" Condition="Exists('$(ValheimManagedDir)\netstandard.dll')">
      <HintPath>$(ValheimManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn" Condition="Exists('$(JotunnDir)\Jotunn.dll')">
      <HintPath>$(JotunnDir)\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Condition="Exists('$(ValheimManagedDir)\assembly_valheim.dll')">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Condition="Exists('$(ValheimManagedDir)\assembly_guiutils.dll')">
      <HintPath>$(ValheimManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Condition="Exists('$(ValheimManagedDir)\assembly_utils.dll')">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="Exists('$(ValheimManagedDir)\Assembly-CSharp.dll')">
      <HintPath>$(ValheimManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ValheimManagedDir)\UnityEngine.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ValheimManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule" Condition="Exists('$(ValheimManagedDir)\UnityEngine.AudioModule.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule" Condition="Exists('$(ValheimManagedDir)\UnityEngine.ImageConversionModule.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll')">
      <HintPath>$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

